# Everything received from the instrument may identify a participant: annex it, so that nothing
# of it enters git history. Only the dataset's own description stays in git.
* annex.largefiles=anything
.gitattributes annex.largefiles=nothing
.gitmodules annex.largefiles=nothing
LICENSE annex.largefiles=nothing
README.md annex.largefiles=nothing
.faire/* annex.largefiles=nothing
.copier-answers.yml annex.largefiles=nothing
