# Containers of the dataset. `faire init` installs each collection as a subdataset at its pinned
# revision, then freezes each container into the dataset's own container configuration.
collections:
  - name: {{ collection_name | tojson }}
    source: {{ collection_source | tojson }}
    path: {{ collection_path | tojson }}
    revision: {{ collection_revision | tojson }}
containers:
  - name: tool
    collection: {{ collection_name | tojson }}
    version: {{ container_version | tojson }}
{%- if container_call_fmt %}
    call_fmt: {{ container_call_fmt | tojson }}
{%- endif %}
