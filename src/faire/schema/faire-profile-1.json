{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UNFmontreal/faire/schema/faire-profile-1.json",
  "title": "faire profile of the RDA DMP Common Standard v1.3",
  "description": "Constraints on the `faire` extension property. A document must also be valid under the unmodified base schema; the two are validated independently.",
  "type": "object",
  "required": [
    "dmp"
  ],
  "properties": {
    "dmp": {
      "type": "object",
      "required": [
        "faire",
        "dataset"
      ],
      "properties": {
        "faire": {
          "$ref": "#/$defs/DmpExtension"
        },
        "dataset": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "faire"
            ],
            "properties": {
              "faire": {
                "$ref": "#/$defs/DatasetExtension"
              },
              "technical_resource": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "faire": {
                      "$ref": "#/$defs/InstrumentExtension"
                    }
                  }
                }
              },
              "distribution": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "faire"
                  ],
                  "properties": {
                    "faire": {
                      "$ref": "#/$defs/DistributionExtension"
                    },
                    "host": {
                      "type": "object",
                      "properties": {
                        "faire": {
                          "$ref": "#/$defs/HostExtension"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Identifier usable in paths and branch names"
    },
    "DmpExtension": {
      "type": "object",
      "required": [
        "sample_entities"
      ],
      "properties": {
        "sample_entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Name"
          },
          "description": "Ordered entity names identifying a sample"
        },
        "hub": {
          "type": "object",
          "required": [
            "host"
          ],
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "description": "host_id identifier of the hub host"
            }
          }
        },
        "coordinator": {
          "$ref": "#/$defs/Name",
          "description": "Site identifier of the coordinator"
        }
      }
    },
    "DatasetExtension": {
      "type": "object",
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "type": "object",
          "required": [
            "repository",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "description": "Pinned tag or commit"
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        "sources": {
          "type": "object",
          "description": "Role of each IsDerivedFrom source, keyed by source dataset identifier",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "triggering",
                  "resource"
                ]
              }
            }
          }
        },
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "date",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "identifiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "identifier",
                    "type"
                  ],
                  "properties": {
                    "identifier": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "InstrumentExtension": {
      "type": "object",
      "required": [
        "instrument_id",
        "site"
      ],
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "$ref": "#/$defs/Name"
        },
        "site": {
          "$ref": "#/$defs/Name"
        }
      }
    },
    "DistributionExtension": {
      "type": "object",
      "required": [
        "stage"
      ],
      "properties": {
        "stage": {
          "enum": [
            "collection",
            "review",
            "accepted",
            "release",
            "archival"
          ]
        },
        "two_way": {
          "type": "boolean"
        },
        "filter": {
          "type": "string",
          "minLength": 1,
          "description": "git-annex preferred-content matching expression selecting the files of the dataset this distribution covers, e.g. `not metadata=distribution-restrictions=sensitive and exclude=*/pilot/*`. Absent means all files. Terms: include=, exclude=, metadata=field=glob, anything, nothing, not, and, or, parentheses."
        }
      }
    },
    "HostExtension": {
      "type": "object",
      "properties": {
        "site_dependent": {
          "type": "boolean"
        },
        "long_term": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "secrets": {
          "type": "object",
          "description": "Parameter name to the name under which the platform stores the secret",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
